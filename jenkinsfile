pipeline{
    agent any
    stages{
        stage('Clone'){
            steps{
                git branch: 'main',
                url: 'https://github.com/Siva-Sai-Bonu/devops-capstone.git'
            }
        }
        stage('Build'){
            steps{
                sh 'docker build -t devops-capstone:v1 .'
            }
        }
        stage('Run'){
            steps{
                sh 'docker stop devops-capstone || true'
                sh 'docker rm devops-capstone || true'
                sh 'docker run -d --name devops-capstone -p 9090:8080 devops-capstone:v1'
            }
        }
    }
    post{
        success{
            echo 'Pipeline Build success'
        }
        failure{
            echo 'Pipeline build failed'
        }
    }
}
